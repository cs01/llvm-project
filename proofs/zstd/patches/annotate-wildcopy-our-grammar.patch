diff --git a/lib/common/zstd_internal.h b/lib/common/zstd_internal.h
index 86a0fc5..86de737 100644
--- a/lib/common/zstd_internal.h
+++ b/lib/common/zstd_internal.h
@@ -214,21 +214,45 @@ typedef enum {
  *         - ZSTD_overlap_src_before_dst: The src and dst may overlap, but they MUST be at least 8 bytes apart.
  *           The src buffer must be before the dst buffer.
  */
+#ifdef ZSTD_CONTRACTS
+#include <c_contracts.h>
+#endif
+
 MEM_STATIC FORCE_INLINE_ATTR
 void ZSTD_wildcopy(void* dst, const void* src, size_t length, ZSTD_overlap_e const ovtype)
+#ifdef ZSTD_CONTRACTS
+  /* What the function requires, written on the function. This replaces a
+     hand-written harness that said exactly the same thing where nobody could
+     review it. length is not capped, so a discharged proof is unbounded. */
+  c_pre     (c_fresh(dst, length + WILDCOPY_OVERLENGTH))
+  c_pre     (c_fresh(src, length + WILDCOPY_OVERLENGTH))
+  c_pre     (length > 0 && length < 0x40000000)
+  c_pre     (ovtype == ZSTD_no_overlap)
+  c_assigns (c_range((BYTE*)dst, 0, length + WILDCOPY_OVERLENGTH))
+#endif
 {
-    ptrdiff_t diff = (BYTE*)dst - (const BYTE*)src;
     const BYTE* ip = (const BYTE*)src;
     BYTE* op = (BYTE*)dst;
+    BYTE* const dstStart = (BYTE*)dst;
     BYTE* const oend = op + length;
 
-    if (ovtype == ZSTD_overlap_src_before_dst && diff < WILDCOPY_VECLEN) {
-        /* Handle short offset copies. */
-        do {
-            COPY8(op, ip);
-        } while (op < oend);
+    /* diff is only defined when the two pointers are in the same object, which
+     * is exactly the overlap case; see FINDING-wildcopy-pointer-subtract.md. */
+    if (ovtype == ZSTD_overlap_src_before_dst &&
+        (BYTE*)dst - (const BYTE*)src < WILDCOPY_VECLEN) {
+        /* Handle short offset copies. COPY8 is itself a do{}while(0), which
+           CBMC counts as a loop, so it is inlined here -- the same trap
+           UNBOUNDED.md records for COPY16. Unreachable under the contract's
+           ovtype == ZSTD_no_overlap, but goto-instrument requires a contract on
+           every loop in the function regardless of reachability. */
+        do
+#ifdef ZSTD_CONTRACTS
+          c_assigns   (c_locations(op, ip))
+          c_invariant (c_same_object(op, (BYTE*)dst))
+          c_decreases ((long)length - c_pointer_offset(op))
+#endif
+        { ZSTD_copy8(op, ip); op += 8; ip += 8; } while (op < oend);
     } else {
-        assert(diff >= WILDCOPY_VECLEN || diff <= -WILDCOPY_VECLEN);
         /* Separate out the first COPY16() call because the copy length is
          * almost certain to be short, so the branches have different
          * probabilities. Since it is almost certain to be short, only do
@@ -239,11 +263,26 @@ void ZSTD_wildcopy(void* dst, const void* src, size_t length, ZSTD_overlap_e con
         if (16 >= length) return;
         op += 16;
         ip += 16;
-        do {
-            COPY16(op, ip);
-            COPY16(op, ip);
+        /* Rewritten from do/while for verification only: goto-instrument
+         * rejects loop contracts on a do loop. Behaviour is identical, the
+         * body still runs at least once. COPY16 is itself a do{}while(0), which
+         * CBMC counts as a loop, so it is inlined here for the same reason. */
+        while (1)
+#ifdef ZSTD_CONTRACTS
+        c_assigns   (c_locations(op, c_locations(ip,
+                        c_range(dstStart, 0, length + WILDCOPY_OVERLENGTH))))
+        c_invariant (c_same_object(op, dstStart))
+        c_invariant (c_same_object(ip, (const BYTE*)src))
+        c_invariant (c_pointer_offset(op) >= 16)
+        c_invariant (c_pointer_offset(op) < (long)length)
+        c_invariant (c_pointer_offset(ip) == c_pointer_offset(op))
+        c_decreases ((long)length - c_pointer_offset(op))
+#endif
+        {
+            ZSTD_copy16(op, ip); op += 16; ip += 16;
+            ZSTD_copy16(op, ip); op += 16; ip += 16;
+            if (!(op < oend)) break;
         }
-        while (op < oend);
     }
 }
 
