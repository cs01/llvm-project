          * probabilities. Since it is almost certain to be short, only do
@@ -239,11 +250,25 @@ void ZSTD_wildcopy(void* dst, const void* src, size_t length, ZSTD_overlap_e con
         if (16 >= length) return;
         op += 16;
         ip += 16;
-        do {
-            COPY16(op, ip);
-            COPY16(op, ip);
+        /* Rewritten from do/while for verification only: goto-instrument
+         * rejects loop contracts on a do loop. Behaviour is identical, the
+         * body still runs at least once. COPY16 is itself a do{}while(0), which
+         * CBMC counts as a loop, so it is inlined here for the same reason. */
+        while (1)
+#ifdef ZSTD_CONTRACTS
+        assigns        (op, ip, dstStart[0 : length + WILDCOPY_OVERLENGTH])
+        loop_invariant (__CPROVER_same_object(op, dstStart))
+        loop_invariant (__CPROVER_same_object(ip, (const BYTE*)src))
+        loop_invariant (__CPROVER_POINTER_OFFSET(op) >= 16)
+        loop_invariant (__CPROVER_POINTER_OFFSET(op) < (long)length)
+        loop_invariant (__CPROVER_POINTER_OFFSET(ip) == __CPROVER_POINTER_OFFSET(op))
+        decreases      ((long)length - __CPROVER_POINTER_OFFSET(op))
+#endif
+        {
