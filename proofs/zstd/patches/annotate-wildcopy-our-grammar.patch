+    if (ovtype == ZSTD_overlap_src_before_dst &&
+        (BYTE*)dst - (const BYTE*)src < WILDCOPY_VECLEN) {
         /* Handle short offset copies. */
         do {
             COPY8(op, ip);
         } while (op < oend);
     } else {
-        assert(diff >= WILDCOPY_VECLEN || diff <= -WILDCOPY_VECLEN);
