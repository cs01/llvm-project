--- a/lib/decompress/zstd_decompress_block.c
+++ b/lib/decompress/zstd_decompress_block.c
@@ -817,11 +817,15 @@
         (*op)[3] = (*ip)[3];
         *ip += dec32table[offset];
         ZSTD_copy4(*op+4, *ip);
-        *ip -= sub2;
+        /* Combine the subtraction with the trailing += 8. Applying them
