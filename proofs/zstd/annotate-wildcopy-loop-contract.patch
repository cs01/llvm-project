--- a/lib/common/zstd_internal.h
+++ b/lib/common/zstd_internal.h
@@ -220,6 +220,7 @@
     ptrdiff_t diff = (BYTE*)dst - (const BYTE*)src;
     const BYTE* ip = (const BYTE*)src;
     BYTE* op = (BYTE*)dst;
+    BYTE* const dstStart = (BYTE*)dst;
     BYTE* const oend = op + length;
 
     if (ovtype == ZSTD_overlap_src_before_dst && diff < WILDCOPY_VECLEN) {
@@ -239,7 +240,14 @@
         if (16 >= length) return;
         op += 16;
         ip += 16;
-        do {
+        do
+        __CPROVER_assigns(op, ip, __CPROVER_object_whole(dstStart))
+        /* Both cursors advance in lockstep and never pass the end by more than
+         * one 32-byte pair, which is what WILDCOPY_OVERLENGTH of slack buys. */
+        __CPROVER_loop_invariant(op <= oend + 31)
+        __CPROVER_loop_invariant((BYTE*)op - (BYTE*)dst == (const BYTE*)ip - (const BYTE*)src)
+        __CPROVER_decreases(oend > (BYTE*)op ? (size_t)((BYTE*)oend - (BYTE*)op) : (size_t)0)
+        {
             COPY16(op, ip);
             COPY16(op, ip);
         }
