--- a/lib/common/zstd_internal.h
+++ b/lib/common/zstd_internal.h
@@ -220,6 +220,7 @@
     ptrdiff_t diff = (BYTE*)dst - (const BYTE*)src;
     const BYTE* ip = (const BYTE*)src;
     BYTE* op = (BYTE*)dst;
+    BYTE* const dstStart = (BYTE*)dst;
     BYTE* const oend = op + length;
 
     if (ovtype == ZSTD_overlap_src_before_dst && diff < WILDCOPY_VECLEN) {
@@ -239,11 +240,22 @@
         if (16 >= length) return;
         op += 16;
         ip += 16;
-        do {
-            COPY16(op, ip);
-            COPY16(op, ip);
+        /* Rewritten from `do { ... } while (op < oend);` for verification
+         * only: CBMC rejects loop contracts on do/while. Behaviour is
+         * identical, the body still runs at least once. */
+        while (1)
+        __CPROVER_assigns(op, ip, __CPROVER_object_upto(dstStart, length + WILDCOPY_OVERLENGTH))
+        __CPROVER_loop_invariant(op < oend + 32)
+        __CPROVER_loop_invariant((BYTE*)op - dstStart == (const BYTE*)ip - (const BYTE*)src)
+        __CPROVER_decreases((size_t)(oend > op ? oend - op : 0))
+        {
+            /* COPY16 is `do { ... } while (0)`, and CBMC counts that idiom as a
+             * loop, which makes loop-contract attachment ambiguous. Inlined
+             * here for verification only; identical semantics. */
+            ZSTD_copy16(op, ip); op += 16; ip += 16;
+            ZSTD_copy16(op, ip); op += 16; ip += 16;
+            if (!(op < oend)) break;
         }
-        while (op < oend);
     }
 }
 
